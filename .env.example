# ─── LLM Provider & API Keys ─────────────────────────
# LLM Provider: "gemini" (default, free tier available) or "openai"
LLM_PROVIDER=gemini

# Gemini API Key (Get a free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if using LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ─── Model Configurations ────────────────────────────
GEMINI_MODEL_NAME=gemini-2.5-flash
OPENAI_MODEL_NAME=gpt-3.5-turbo

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ─── Text Splitting ──────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ─── Retrieval ───────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
